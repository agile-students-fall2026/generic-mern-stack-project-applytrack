# Copy this file to .env and fill in the values. Never commit .env (it's in .gitignore).

# Port the back-end listens on
PORT=3000

# Address of the React app, allowed to call this server (CORS)
FRONT_END_URL=http://localhost:5173

# Secret used to sign login tokens. Use any long random text, e.g. from: node -e "console.log(crypto.randomUUID())"
JWT_SECRET=replace-with-a-long-random-secret
